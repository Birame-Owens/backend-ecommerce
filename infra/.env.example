# ─── Docker Compose — variables d'environnement ──────────────────────────────
# Copier en .env et remplir les valeurs manquantes
# cp .env.example .env

# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

# APP_KEY: générer avec -> php artisan key:generate --show
APP_KEY=

FRONTEND_URL=http://localhost:3000
ADMIN_PATH=ndeya-backoffice

# Base de données PostgreSQL
DB_DATABASE=ndeya
DB_USERNAME=postgres
DB_PASSWORD=password
DB_PORT=5432

# Redis
REDIS_PORT=6379

# CORS (séparés par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:3000

# Mail (log par défaut)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@ndeya-shop.local

# NabooPay (paiement)
NABOOPAY_API_KEY=
NABOOPAY_WEBHOOK_SECRET=
