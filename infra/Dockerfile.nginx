# ─── Nginx (reverse proxy vers PHP-FPM) ─────────────────────────────────────
# Context attendu: racine du repo (ndeya-shop/)
# ─────────────────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

COPY infra/docker/nginx/backend.conf /etc/nginx/conf.d/default.conf
COPY backend/public /app/public

RUN mkdir -p /app/storage/app/public

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
