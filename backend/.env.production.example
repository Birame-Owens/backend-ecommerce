# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="NDEYA SHOP"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_URL=https://api.nd-world.site
FRONTEND_URL=https://nd-world.site

# ─── Base de données (PostgreSQL via Coolify) ─────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=YOUR_COOLIFY_POSTGRES_HOST
DB_PORT=5432
DB_DATABASE=ndeya
DB_USERNAME=ndeya_user
DB_PASSWORD=STRONG_PASSWORD_HERE

# ─── Cache / Sessions / Queue (Redis via Coolify) ────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=YOUR_COOLIFY_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.nd-world.site

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://nd-world.site,https://www.nd-world.site

# ─── Sanctum ──────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=nd-world.site,www.nd-world.site

# ─── Mail (SMTP production) ───────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=contact@nd-world.site
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contact@nd-world.site
MAIL_FROM_NAME="NDEYA SHOP"

ADMIN_NOTIFICATION_EMAIL=birameowensdiop@gmail.com

# ─── Paiement NabooPay ───────────────────────────────────────────────────────
NABOOPAY_BASE_URL=https://api.naboopay.com
NABOOPAY_API_KEY=YOUR_NABOOPAY_KEY
NABOOPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ─── Storage (Coolify utilise le volume local) ────────────────────────────────
FILESYSTEM_DISK=public

# ─── Logs ─────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=warning
